# n8n webhook base — same for every build target (GitHub Pages, the temp
# EC2 deploy, the real production server), so it belongs here, not in a
# mode-specific .env file. Vite only merges the shared .env with the ONE
# .env.<mode> file matching the exact --mode used, not every .env.* file —
# a build under a mode other than plain "production" (e.g. our
# production-server mode) would otherwise silently fall back to the
# relative '/psri-webhook' default in src/api/psri.js, which 404s on any
# real static host (only Vite's own dev-server proxy understands it).
VITE_PSRI_API_BASE=https://automation.openmindhelpline.com/webhook

# SparkTG CTI Widget — leave blank to disable the dialer feature entirely
VITE_SPARKTG_WIDGET_URL=https://telephonycloud.co.in/sparktg-iframe/

# Microsoft Azure AD — same app registration as VMM CRM. Not secret: these
# are public identifiers (visible in every login URL anyway), not
# credentials — the real security boundary is Azure's registered redirect
# URIs plus the person's own Microsoft login. Committed so a fresh clone
# works without everyone needing their own undocumented .env.local.
VITE_AZURE_CLIENT_ID=23cc525a-0ef9-420f-b82d-b5be71d2caa1
VITE_AZURE_TENANT_ID=6fb82fad-19c7-41e5-b5e1-e7e1b02b0323
